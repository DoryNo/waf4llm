# App
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Upstream LLM (OpenAI-compatible)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-...
UPSTREAM_MODEL=gpt-4o-mini
UPSTREAM_TIMEOUT_SECONDS=60

# Security policy
FAIL_MODE=closed  # open | closed
ENABLE_PROVENANCE=true
ENABLE_NORMALIZER=true
ENABLE_HEURISTIC=true
ENABLE_CLASSIFIER=false
ENABLE_OUTPUT_GUARD=true

# Heuristic / classifier
HEURISTIC_RULES_PATH=rules/heuristic.yaml
HEURISTIC_PERPLEXITY_ENABLED=false
HEURISTIC_PERPLEXITY_MODEL=distilgpt2
CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
CLASSIFIER_BATCH_SIZE=8
CLASSIFIER_MAX_LENGTH=512
CLASSIFIER_DEVICE=cpu
# CLASSIFIER_ONNX_PATH=models/classifier.onnx
MULTITURN_WINDOW=6
MULTITURN_CUMULATIVE_THRESHOLD=1.2
THRESHOLD_LOG=0.3
THRESHOLD_SANITIZE=0.55
THRESHOLD_EXCLUDE=0.7
THRESHOLD_BLOCK=0.85

# DB
DATABASE_URL=postgresql+asyncpg://waf:waf@postgres:5432/waf
# For local without docker:
# DATABASE_URL=postgresql+asyncpg://waf:waf@localhost:5432/waf
# Fallback sqlite for dev without postgres:
# DATABASE_URL=sqlite+aiosqlite:///./waf.db

# Redis
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true

# Canary
CANARY_ENABLED=true
CANARY_LENGTH=16

# Request logging (dashboard data source)
LOG_REQUESTS_ENABLED=true

# Alerts (Phase 9.3) — webhook/Slack on critical blocks
ALERTS_ENABLED=false
# ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERTS_MIN_LEVEL=block
# ALERTS_MIN_LEVEL=log|sanitize|exclude|block
ALERTS_TIMEOUT_SECONDS=5

# XAI / explainability (Phase 8)
# Attention-based token importance rides on the classifier forward pass (hot path)
XAI_ATTENTION_ENABLED=true
XAI_TOP_K=10
# Integrated Gradients (Captum) — on-demand only, heavier (~32 forward passes)
XAI_IG_ENABLED=false
XAI_IG_STEPS=32
# Store attributions in the attributions table (shown in dashboard)
XAI_STORE_ENABLED=true

# Continuous retraining (Phase 10)
# Auto-collect borderline/blocked requests as injection examples
RETRAIN_ENABLED=false
# confidence floor for auto-collection (log-level requests)
RETRAIN_BORDERLINE_MIN=0.3
# max pending items in retrain_queue (older ones kept, new dropped when full)
RETRAIN_MAX_QUEUE=10000
# public corpora dir (JSONL {text,label} lines) merged into every dataset build
RETRAIN_CORPUS_DIR=data/corpora
# output dir for train.jsonl / val.jsonl
RETRAIN_DATASET_DIR=data/datasets
# val fraction for the stratified split
RETRAIN_VAL_SPLIT=0.1
RETRAIN_SEED=42
# model version index
RETRAIN_REGISTRY_PATH=models/registry.json
